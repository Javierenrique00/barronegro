<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (dataExtractionRules).
    El archivo de preferencias guarda la contraseña del administrador para el inicio automático,
    así que se excluye de la copia en la nube y de la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="org.mundocreativo.barronegro_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="org.mundocreativo.barronegro_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
